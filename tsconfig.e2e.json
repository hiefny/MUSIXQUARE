{
  // Typecheck Playwright specs and configuration, which are outside the app
  // and Vitest tsconfig include sets. `npm run typecheck` invokes this config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Playwright helpers and reporters run in Node and use its host APIs.
    "types": ["node"],
    // E2E scaffolding may retain temporary helpers; this config focuses on
    // type and cross-file contract drift rather than unused-symbol hygiene.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts", "playwright.webkit.config.ts"]
}
