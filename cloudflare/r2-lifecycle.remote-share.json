{
  "rules": [
    {
      "id": "Delete active remote share objects",
      "enabled": true,
      "conditions": {
        "prefix": "room/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 86400
        }
      }
    },
    {
      "id": "Delete retired remote share objects",
      "enabled": true,
      "conditions": {
        "prefix": "plain-room/"
      },
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 86400
        }
      }
    }
  ]
}
