{
  "name": "musixquare",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checked": "npm run build && npm run guard:prod-hooks && npm run guard:prod-security",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "guard:prod-hooks": "node scripts/assert-production-build-clean.mjs",
    "guard:prod-security": "node scripts/assert-production-security-config.mjs",
    "typecheck": "tsc --noEmit && tsc -p src/workers/tsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:report": "npm run build:e2e",
    "test:e2e:report": "playwright test --reporter=./e2e/live-reporter.ts,line",
    "test:report-viewer": "npx serve . -p 3333 -s",
    "test:all": "vitest run && npm run build:checked && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "peer": "^1.0.2",
    "prettier": "^3.8.1",
    "satori": "^0.26.0",
    "subset-font": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "content-shield": "^0.1.1",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "realtime-bpm-analyzer": "^5.0.2"
  }
}
