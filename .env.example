# See docs/configuration-reference.md for local/browser configuration.
# This flag controls only Vite's six named relative production-proxy routes.
# PRO fallback applies in every mode; non-E2E TURN/Realtime retries are separate.
MUSIXQUARE_DEV_PROXY_PRODUCTION_API=false

# Localhost uses PeerJS automatically. Set these only when intentionally
# exercising a separately running signaling Worker.
# VITE_MUSIXQUARE_TRANSPORT=cloudflare
# VITE_MUSIXQUARE_SIGNALING_URL=ws://127.0.0.1:8787/api/rooms
# The fallback must use a different origin with the same protocol and path.
# VITE_MUSIXQUARE_SIGNALING_FALLBACK_URL=ws://127.0.0.1:8788/api/rooms

# Invalid or missing PRO overrides fall back to production. Uncomment only
# when a complete local PRO boundary or intentional mock is listening here.
# VITE_PRO_ROOM_ENDPOINT=http://127.0.0.1:8789

# Public browser logging threshold: DEBUG, INFO, WARN, ERROR, or SILENT.
# VITE_MUSIXQUARE_LOG_LEVEL=DEBUG
