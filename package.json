{
  "name": "musixquare",
  "version": "7.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checked": "npm run build && npm run guard:prod-hooks && npm run guard:prod-security && npm run guard:font-build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "promo:render": "tsx .workshop/promo/render.ts",
    "guard:prod-hooks": "node scripts/assert-production-build-clean.mjs",
    "guard:prod-security": "node scripts/assert-production-security-config.mjs",
    "guard:bus-pairing": "node scripts/check-bus-pairing.mjs",
    "guard:chunk-pump": "node scripts/check-chunk-pump.mjs",
    "guard:import-graph": "node scripts/check-import-graph.mjs",
    "guard:lifecycle-writes": "node scripts/check-lifecycle-writes.mjs",
    "guard:dead-exports": "node scripts/check-dead-exports.mjs",
    "guard:font-assets": "node scripts/check-app-font.mjs",
    "guard:font-build": "node scripts/check-app-font.mjs --dist",
    "smoke:live:signaling": "node scripts/live-signaling-smoke.mjs",
    "smoke:live:remote-share": "tsx scripts/live-remote-share-smoke.ts",
    "smoke:live:app-session": "tsx scripts/live-app-session-smoke.ts",
    "smoke:live": "npm run smoke:live:signaling && npm run smoke:live:remote-share && npm run smoke:live:app-session",
    "typecheck": "tsc --noEmit && tsc -p src/workers/tsconfig.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:report": "npm run build:e2e",
    "test:e2e:report": "playwright test --reporter=./e2e/live-reporter.ts,line",
    "pretest:e2e:runtime": "npm run build:e2e",
    "test:e2e:runtime": "playwright test e2e/late-join.test.ts e2e/playback-sync.test.ts e2e/youtube-sync.test.ts e2e/reconnection.test.ts e2e/background-resume.test.ts",
    "test:report-viewer": "npx serve . -p 3333 -s",
    "test:all": "vitest run && npm run build:checked && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "peer": "^1.0.2",
    "prettier": "^3.8.1",
    "satori": "^0.26.0",
    "subset-font": "^2.5.0",
    "three": "^0.184.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^4.0.18",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@wasm-audio-decoders/flac": "0.2.10",
    "codec-parser": "2.5.0",
    "content-shield": "^0.1.1",
    "lanczos-resampler": "0.4.1",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4"
  }
}
