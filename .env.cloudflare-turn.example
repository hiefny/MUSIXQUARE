# Copy this file, replace the placeholder values, then set them as secrets on
# the Cloudflare app worker (e.g. `npx wrangler secret put CLOUDFLARE_TURN_KEY_ID --config cloudflare/wrangler.app.toml`).
# Do not set them while the placeholder values are still present.

CLOUDFLARE_TURN_KEY_ID=replace_with_cloudflare_turn_key_id
CLOUDFLARE_TURN_API_TOKEN=replace_with_cloudflare_turn_api_token

# Optional Cloudflare Realtime SFU beta for remote system-audio fanout.
CLOUDFLARE_REALTIME_APP_ID=replace_with_cloudflare_realtime_app_id
CLOUDFLARE_REALTIME_API_TOKEN=replace_with_cloudflare_realtime_api_token

# Optional Metered fallback. Keep these only if you want Metered as backup.
TURN_USER=replace_with_metered_turn_user
TURN_PASS=replace_with_metered_turn_pass
