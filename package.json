{
  "name": "musixquare",
  "version": "8.0.9",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/materialize-app-static-headers.mjs",
    "build:checked": "npm run guard:release-identity && npm run guard:sw-cache-version && npm run guard:profanity-patterns && npm run build && npm run guard:prod-hooks && npm run guard:prod-security && npm run guard:font-build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "promo:render": "tsx .workshop/promo/render.ts",
    "guard:prod-hooks": "node scripts/assert-production-build-clean.mjs",
    "guard:prod-security": "node scripts/assert-production-security-config.mjs",
    "guard:bus-pairing": "node scripts/check-bus-pairing.mjs",
    "guard:chunk-pump": "node scripts/check-chunk-pump.mjs",
    "guard:import-graph": "node scripts/check-import-graph.mjs",
    "generate:profanity-patterns": "node scripts/generate-profanity-patterns.mjs",
    "guard:profanity-patterns": "node scripts/generate-profanity-patterns.mjs --check",
    "guard:lifecycle-writes": "node scripts/check-lifecycle-writes.mjs",
    "guard:dead-exports": "node scripts/check-dead-exports.mjs",
    "guard:font-assets": "node scripts/check-app-font.mjs",
    "guard:font-build": "node scripts/check-app-font.mjs --dist",
    "guard:release-identity": "node scripts/release-identity.mjs",
    "guard:sw-cache-version": "node scripts/check-sw-cache-version.mjs",
    "guard:developer-api-boundaries": "node scripts/check-developer-api-boundaries.mjs",
    "guard:d1-migrations": "node scripts/check-d1-migration-contract.mjs",
    "guard:ops-drift-contract": "node scripts/audit-ops-drift.mjs --source-only",
    "ops:drift": "node scripts/audit-ops-drift.mjs",
    "check:pro-room-worker": "node --check cloudflare/pro-room-worker.js && npm run guard:prod-security",
    "check:developer-api-workers": "node --check cloudflare/developer-api-worker.js && node --check cloudflare/developer-api-facade-worker.js && npm run guard:developer-api-boundaries",
    "check:workers": "node --check cloudflare/account-nickname.js && node --check cloudflare/account-assertion.js && node --check cloudflare/standard-room-account-assertion.js && node --check cloudflare/account-auth.js && node --check cloudflare/app-worker.js && node --check cloudflare/pro-bot.js && node --check cloudflare/signaling-worker.js && node --check cloudflare/remote-share-worker.js && node --check cloudflare/pro-room-worker.js && npm run check:developer-api-workers && npm run guard:d1-migrations && npm run guard:ops-drift-contract",
    "smoke:live:signaling": "node scripts/live-signaling-smoke.mjs",
    "smoke:live:pro-room": "node scripts/live-pro-room-smoke.mjs",
    "smoke:live:developer-api": "node scripts/live-developer-api-smoke.mjs",
    "smoke:live:remote-share": "tsx scripts/live-remote-share-smoke.ts",
    "smoke:live:app-session": "tsx scripts/live-app-session-smoke.ts",
    "smoke:live": "npm run smoke:live:remote-share && npm run smoke:live:signaling && npm run smoke:live:pro-room && npm run smoke:live:app-session",
    "wrangler": "npx --yes wrangler@4.111.0",
    "release:manifest": "node scripts/release-manifest.mjs create",
    "release:verify": "node scripts/release-manifest.mjs verify",
    "version:status": "node scripts/release-identity.mjs",
    "pro-room:issue-claim": "node scripts/issue-pro-room-activation-claim.mjs",
    "account:stage2:preflight": "node scripts/account-stage2-preflight.mjs",
    "account:nickname-key:migrate:remote": "npm run wrangler -- d1 execute musixquare-auth --remote --config cloudflare/wrangler.app.toml --file cloudflare/auth.nickname-key.migration.sql",
    "developer-api:key": "node scripts/developer-api-key.mjs",
    "developer-api:admin-secret:sync": "node scripts/sync-developer-api-admin-secret.mjs",
    "developer-api:schema:remote": "npm run wrangler -- d1 execute musixquare-developer-api --remote --file cloudflare/developer-api.schema.sql --config cloudflare/wrangler.developer-api.toml",
    "developer-api:effects-scopes:remote": "node scripts/developer-api-effects-scope-migration.mjs apply",
    "developer-api:effects-scopes:rollback:remote": "node scripts/developer-api-effects-scope-migration.mjs rollback",
    "developer-api:effects-scopes:release-rollback": "node scripts/developer-api-effects-scope-migration.mjs release-rollback",
    "deploy:remote-share": "node scripts/guard-emergency-deploy.mjs reject remote-share",
    "deploy:pro-room": "node scripts/guard-emergency-deploy.mjs reject pro-room",
    "deploy:developer-api-facade": "node scripts/guard-emergency-deploy.mjs reject developer-api-facade",
    "deploy:developer-api": "node scripts/guard-emergency-deploy.mjs reject developer-api",
    "deploy:developer-api-stack": "node scripts/guard-emergency-deploy.mjs reject developer-api-stack",
    "deploy:signaling": "node scripts/guard-emergency-deploy.mjs reject signaling",
    "deploy:app": "node scripts/guard-emergency-deploy.mjs reject app",
    "deploy:all-workers": "node scripts/guard-emergency-deploy.mjs reject all-workers",
    "emergency:deploy:remote-share": "node scripts/emergency-deploy.mjs remote-share",
    "emergency:deploy:pro-room": "node scripts/emergency-deploy.mjs pro-room",
    "emergency:deploy:developer-api-facade": "node scripts/emergency-deploy.mjs developer-api-facade",
    "emergency:deploy:developer-api": "node scripts/emergency-deploy.mjs developer-api",
    "emergency:deploy:developer-api-stack": "node scripts/emergency-deploy.mjs developer-api-stack",
    "emergency:deploy:signaling": "node scripts/emergency-deploy.mjs signaling",
    "emergency:deploy:app": "node scripts/emergency-deploy.mjs app",
    "emergency:deploy:all-workers": "node scripts/emergency-deploy.mjs all-workers",
    "typecheck": "tsc --noEmit && tsc -p src/workers/tsconfig.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:release": "npm run build:e2e",
    "test:e2e:release": "playwright test e2e/release-smoke.test.ts --project=chromium --reporter=line",
    "pretest:e2e:report": "npm run build:e2e",
    "test:e2e:report": "playwright test --reporter=./e2e/live-reporter.ts,line",
    "pretest:e2e:runtime": "npm run build:e2e",
    "test:e2e:runtime": "playwright test e2e/late-join.test.ts e2e/playback-sync.test.ts e2e/youtube-sync.test.ts e2e/reconnection.test.ts e2e/background-resume.test.ts",
    "test:report-viewer": "npx serve . -p 3333 -s",
    "test:all": "vitest run && npm run build:checked && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "peer": "^1.0.2",
    "prettier": "^3.8.1",
    "satori": "^0.26.0",
    "subset-font": "^2.5.0",
    "three": "^0.184.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.3",
    "vitest": "^4.0.18",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "content-shield": "^0.1.1",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4"
  }
}
