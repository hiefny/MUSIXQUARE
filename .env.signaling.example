# Enable the PeerJS-independent Cloudflare Durable Object signaling transport.
# The URL should point at the Worker route/custom domain, not at a room.
#
# Example:
# VITE_MUSIXQUARE_SIGNALING_URL=wss://signal.musixquare.com/api/rooms

VITE_MUSIXQUARE_TRANSPORT=cloudflare
VITE_MUSIXQUARE_SIGNALING_URL=wss://signal.musixquare.com/api/rooms
