{
  "rules": [
    {
      "id": "musixquare-demo-track-read",
      "allowed": {
        "origins": [
          "https://musixquare.com",
          "https://www.musixquare.com",
          "https://demo.musixquare.com",
          "http://localhost:3000",
          "http://127.0.0.1:3000",
          "http://localhost:4173",
          "http://127.0.0.1:4173",
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:5174",
          "http://127.0.0.1:5174",
          "http://localhost:5175",
          "http://127.0.0.1:5175",
          "http://localhost:5176",
          "http://127.0.0.1:5176",
          "http://localhost:5177",
          "http://127.0.0.1:5177",
          "http://localhost:5178",
          "http://127.0.0.1:5178",
          "http://localhost:5179",
          "http://127.0.0.1:5179",
          "http://localhost:5180",
          "http://127.0.0.1:5180"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "content-type"]
      },
      "exposeHeaders": ["accept-ranges", "cache-control", "content-length", "content-type", "etag"],
      "maxAgeSeconds": 86400
    }
  ]
}
